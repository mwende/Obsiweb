# Öffentliche URL der App (ohne abschließenden Slash)
BASE_URL=https://notes.example.com
PORT=3000
HOST=127.0.0.1

# Zufälliger String, mindestens 32 Zeichen: openssl rand -base64 48
SESSION_SECRET=

# Produktion (CloudPanel): mysql://USER:PASS@127.0.0.1:3306/DBNAME
# Lokale Entwicklung:      sqlite:./data/dev.sqlite
DATABASE_URL=mysql://obsiweb:CHANGE_ME@127.0.0.1:3306/obsiweb

# Speicherort der Vaults (außerhalb des Webroots!)
DATA_DIR=/var/lib/obsiweb
MAX_UPLOAD_MB=100
# Unterordner für Anhänge, relativ zum Ordner der aktuellen Notiz
ATTACHMENTS_DIR=attachments

# --- Optional: Login über Microsoft Entra ID -------------------------------
# Nur aktiv, wenn alle drei Werte gesetzt sind.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# Kommagetrennte erlaubte Tenant-IDs (Standard: ENTRA_TENANT_ID)
# ALLOWED_TENANTS=
# Unbekannte Microsoft-Nutzer automatisch anlegen (sonst nur bestehende Konten per E-Mail verknüpfen)
# ENTRA_AUTO_CREATE=false
